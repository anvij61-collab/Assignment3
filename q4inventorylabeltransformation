import java.util.*;

public class q4inventorylabeltransformation {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine().toUpperCase();

        String[] words = s.split(" ");
        String finalresult = "";

        for (int i = 0; i < words.length; i++) {

            String word = words[i];
            String result = "";

            for (int j = 0; j < word.length() / 2; j++) {

                char ch1 = word.charAt(j);
                char ch2 = word.charAt(word.length() - 1 - j);

                int a = ch1 - 'A' + 1;
                int b = ch2 - 'A' + 1;

                int difference = Math.abs(a - b);

                if (difference % 2 != 0) {
                    difference = difference * 2;
                } else {
                    difference = difference / 2;
                }

                result += difference;
            }

            if (word.length() % 2 != 0) {

                char middle = word.charAt(word.length() / 2);
                int pos = middle - 'A' + 1;

                result += pos;
            }

            finalresult += result;
        }

        System.out.println(finalresult);
    }
}
/* Input:  ABC  
Output: 12 
Explanation: Pair A–C: difference 2, which is even.
Transformed value: 2/2=1. 
Middle character B has pos on 2,
Concatenating 1 and 2 gives 12. */
