/*Input: ABA CAT  
Output: 872  
Explanation: 
    For ABA:  Sum of positions: 1+2+1=4 
    Distinct characters: A and B, giving 2. 
    Code: 4 X 2=8. 
    
    For CAT: Sum of positions: 3+1+20=24 
    Distinct characters: 3
     Code: 24 X 3=72. 
    Concatenate 8 and 72. */

import java.util.*;
public class q7Aibaseddoc {
    public static void main(String[] args) {
    String s = "ABA CAT";
    String[] words = s.split(" ");
    String finalresult = "";

    for(int i=0; i<words.length; i++){
        String word = words[i];
        int sum =0;
        HashSet<Character> set = new HashSet<>();

                for (int j = 0; j < word.length() - 1; j++) {
                    sum += word.charAt(j) -'A' +1;

                    set.add(word.charAt(j));
                }
                    int distinct = set.size();

                    int code = sum*distinct;
                    finalresult+= code;
            }
        System.out.println(finalresult);
        }     
    }
